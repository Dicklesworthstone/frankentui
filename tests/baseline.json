{
  "_comment": "Performance baseline for FrankenTUI CI regression gate (bd-3fc.4).",
  "_format": "Criterion entries map a logical benchmark to a criterion name, with p50/p95/p99/p999 budgets in nanoseconds and an slo_metric for slo.yaml validation.",
  "_threshold": "Regression alert if observed mean exceeds baseline p99 by threshold_pct.",
  "_updated": "2026-07-20",
  "_presenter_color_depth": "truecolor",

  "frame_render": {
    "description": "Full frame render pipeline (diff + present, 80x24 @ 5% change)",
    "criterion_name": "pipeline/truecolor/diff_and_present/full/80x24@5%",
    "bench_file": "presenter_bench",
    "crate": "ftui-render",
    "slo_metric": "render_frame_p99_us",
    "p50_ns":  500000,
    "p95_ns": 1000000,
    "p99_ns": 2000000,
    "p999_ns": 5000000,
    "threshold_pct": 10
  },

